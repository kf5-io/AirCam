{
  "name": "aircam",
  "version": "0.1.0",
  "description": "La caméra de ton iPhone comme webcam sur Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "get-softcam": "node scripts/get-softcam.js",
    "dist": "npm run get-softcam && electron-builder --win nsis",
    "test": "node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kf5-io/AirCam.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kf5-io/AirCam/issues"
  },
  "homepage": "https://github.com/kf5-io/AirCam#readme",
  "productName": "AirCam",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "koffi": "^3.3.8",
    "plist": "^5.1.2"
  },
  "build": {
    "appId": "io.kf5.aircam",
    "productName": "AirCam",
    "files": [
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "vendor/softcam",
        "to": "softcam"
      },
      {
        "from": "vendor/mfcam",
        "to": "mfcam"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AirCam",
      "include": "build/installer.nsh",
      "artifactName": "AirCam-Setup-${version}.${ext}"
    }
  }
}
